# ==========================================
# Configurações do Agente AI Naiah
# ==========================================

# Sua chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini a ser utilizado (Recomendado para plano gratuito: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Nome do Agente e do Candidato
ASSISTANT_NAME=Naiah
CANDIDATE_NAME=André Capela
CANDIDATE_EMAIL=andr.capela@gmail.com
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/andre-capela

# Rate Limiting (Proteção contra abuso e esgotamento da cota)
RATE_LIMIT_MAX_PER_MINUTE=5
RATE_LIMIT_MAX_PER_SESSION=25

# Temperatura da geração (0.0 a 1.0 - valores baixos garantem maior precisão e fidelidade ao currículo)
TEMPERATURE=0.3
